+  for (const [taskId, staffId] of assignments) {
+    const task = state.tasks.find(item => item.id === taskId);
+    if (task && task.completedDay === null) state = command(state, { type: 'ASSIGN_TASK', taskId, staffId }, trace);
+  }
+  return state;
