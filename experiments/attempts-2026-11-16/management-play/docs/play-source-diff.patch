+    } },
+  { id: 'accept_deadline_handoff', label: '기한 준수 인계', accept: true,
+    setup: (state, trace) => plan(state, [['jung-organize', 'kim'], ['go-memo', 'lee'], ['yoon-collect', 'park'], ['yoon-brief', 'kim']], trace),
