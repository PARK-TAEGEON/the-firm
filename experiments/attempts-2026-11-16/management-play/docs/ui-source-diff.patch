+.avatar-line small {font-size:12px;margin-top:2px}
+.review-bar {min-height:38px;height:auto;background:var(--top);border-color:var(--line-soft);padding:5px 26px;color:var(--dim);font-size:12px;gap:16px}
+.review-caption {letter-spacing:0;gap:12px;font-size:12px}
+.review-caption b {color:var(--muted);font-size:12px}
+.review-tabs {gap:2px;background:var(--surface);padding:2px;border:1px solid var(--line-soft);border-radius:5px}
+.review-tabs button {min-height:28px;padding:3px 12px;font-size:12px;color:var(--muted);border-radius:3px}
