+.case-context-card.active,.case-context-card[aria-current="true"],.case-context-card[aria-pressed="true"] {background:var(--accent-bg);border-color:var(--line);border-left-color:var(--accent);color:var(--text)}
+.case-context-card:hover {background:var(--surface2)}
+.case-context-card strong {display:block;font-size:16px;font-weight:600;line-height:1.5;margin:4px 0}
+.case-context-card small,.case-context-card>span {display:block;font-size:12px;line-height:1.7;color:var(--muted)}
+.case-context-card .pill {display:inline-flex;margin-top:8px}
+.file-list-label {font-size:11px;letter-spacing:.1em;color:var(--dim);line-height:1.5;margin-bottom:14px}
+.file-tab {border-radius:4px;border:1px solid var(--line-soft);border-left:3px solid transparent;padding:16px;margin-bottom:8px;background:var(--surface);color:var(--muted)}
+.file-tab.active {background:var(--accent-bg);border-left-color:var(--accent);color:var(--text)}
+.file-tab:hover {background:var(--surface2)}
+.file-tab .file-no {color:var(--brass);font-size:11px;font-family:var(--numeric)}
+.file-tab strong {font-size:17px;line-height:1.5;margin:6px 0 5px;font-weight:600}
+.file-tab small {font-size:12px;line-height:1.8}
+.file-side-note {font-size:12px;line-height:1.9;padding:14px 8px;color:var(--dim)}
+.dossier {border:1px solid var(--paper-line);border-radius:5px;min-height:0;box-shadow:0 12px 34px #0002;overflow:hidden;background:var(--paper);color:var(--ink)}
+.dossier-top {padding:25px 30px 22px;gap:20px;border-bottom-color:var(--paper-line);background:var(--paper-raised)}
