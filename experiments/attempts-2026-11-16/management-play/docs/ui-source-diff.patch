+.btn {min-height:44px;padding:10px 17px;border-radius:4px;font-size:14px;font-weight:600;border-color:var(--line);background:var(--surface2);color:var(--text)}
+.btn:hover:not(:disabled) {background:color-mix(in srgb,var(--surface2) 86%,var(--text));border-color:var(--dim)}
