+.btn.small {min-height:38px;padding:7px 12px;font-size:13px}
+.btn.danger-btn {background:var(--redbg);border-color:color-mix(in srgb,var(--red) 48%,var(--line));color:var(--red)}
+.icon-btn {width:40px;height:40px;color:var(--muted);border-radius:4px}
+.link-btn {min-height:32px;font-size:13px;color:var(--accent);text-align:left}
+.pill {font-size:12px;padding:3px 8px;line-height:1.6;border-color:var(--line);color:var(--muted);border-radius:3px}
+.pill.warm {color:var(--warning);background:var(--warning-bg);border-color:color-mix(in srgb,var(--warning) 38%,var(--line))}
+.pill.red {color:var(--red);background:var(--redbg);border-color:color-mix(in srgb,var(--red) 38%,var(--line))}
+.pill.green {color:var(--green);background:color-mix(in srgb,var(--green) 10%,var(--surface));border-color:color-mix(in srgb,var(--green) 35%,var(--line))}
+.portrait {border-radius:4px;background-color:var(--surface2);box-shadow:0 0 0 1px #ffffff12,inset 0 -10px 14px #0002;filter:saturate(.68) contrast(1.02)}
+.avatar-line {gap:10px}
