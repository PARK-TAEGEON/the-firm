+.screen-head {margin-bottom:22px;gap:18px;align-items:flex-end}
+.chapter {font-family:var(--numeric);font-size:11px;letter-spacing:.13em;color:var(--dim)}
+.screen-head h1 {font-size:28px;line-height:1.25;font-weight:650;letter-spacing:-.055em;margin-top:7px}
+.screen-head .sub {font-size:14px;color:var(--muted);margin-top:8px;line-height:1.65}
