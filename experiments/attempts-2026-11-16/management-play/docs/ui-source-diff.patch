+
+/* Case context and document hierarchy. */
+.case-workspace,.dossier-layout {display:grid;grid-template-columns:216px minmax(0,1fr);gap:24px;align-items:start}
+.case-workspace-list,.file-list {min-width:0;position:sticky;top:20px;padding:0}
