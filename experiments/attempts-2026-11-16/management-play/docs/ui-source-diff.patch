+.theme-option small {display:block;font-size:12px;color:var(--muted);margin-top:3px;line-height:1.7}
+.theme-option.selected,.theme-option.active,.theme-option[aria-pressed="true"] {border-color:var(--accent);background:var(--accent-bg);box-shadow:inset 0 0 0 1px var(--accent)}
+.theme-option:before {content:'';display:block;width:26px;height:36px;border-radius:3px;flex:none;border:1px solid #ffffff33;box-shadow:inset 0 -9px 0 #d1b37a}
+.theme-option[data-id="graphite"]:before {background:#171c21;box-shadow:inset 0 -9px 0 #75c8c7}
+.theme-option[data-id="navy"]:before {background:#16263b}
+.theme-option[data-id="paper"]:before {background:#f0ebdf;box-shadow:inset 0 -9px 0 #23476e;border-color:#bfb7a7}
+.font-option {background:var(--bg);color:var(--text);border:1px solid var(--line);border-radius:4px;text-align:left;padding:13px 15px;min-height:74px;line-height:1.7;display:flex;flex-direction:column;gap:3px}
