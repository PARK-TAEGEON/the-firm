+.font-status {font-size:12px;line-height:1.8;color:var(--muted);padding:11px 14px;border:1px solid var(--line);background:var(--surface2);border-radius:4px;margin:10px 0}
+.font-preview {padding:20px;background:var(--paper);color:var(--ink);border-radius:4px;border:1px solid var(--paper-line);margin:15px 0}
