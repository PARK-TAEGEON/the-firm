+}
+:root[data-theme="navy"] {
+  --bg:#0d1828; --surface:#16263b; --surface2:#223650;
+  --line:#364c66; --line-soft:#263b53;
+  --text:#f2eee4; --muted:#b2bdca; --dim:#9baabd;
+  --gold:#dfbe7d; --gold-soft:#9e824e;
+  --accent:#dfbe7d; --accent-bg:#333328; --accent-ink:#172133;
+  --top:#08111d; --nav:#101e30;
+  --red:#ffaaa1; --redbg:#3b2732; --green:#9cd3ba;
+  --warning:#f0c78a; --warning-bg:#302e29;
+}
+:root[data-theme="paper"] {
+  --bg:#e9e4d9; --surface:#fffdf8; --surface2:#f3eee4;
+  --line:#bfb7a7; --line-soft:#d5cebf;
+  --text:#27333e; --muted:#56636d; --dim:#65717b;
+  --gold:#23476e; --gold-soft:#7588a0;
+  --accent:#23476e; --accent-bg:#e2eaf1; --accent-ink:#fff;
+  --top:#f8f5ed; --nav:#e0dacc;
+  --red:#a93832; --redbg:#f7e6e1; --green:#326c50;
