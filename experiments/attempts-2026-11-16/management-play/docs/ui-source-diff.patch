+.brand-symbol:after {content:'';position:absolute;inset:3px;border:1px solid color-mix(in srgb,var(--brass) 35%,transparent);pointer-events:none}
+.brand-word {font-family:Georgia,'Times New Roman',serif;font-size:23px;letter-spacing:.12em}
