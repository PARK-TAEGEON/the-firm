+.paper .btn.primary:hover,.brief-paper .btn.primary:hover,.paper-btn:hover,.week-summary .btn:hover {background:#3c4a57;border-color:#3c4a57}
+.brief-paper .link-btn {color:#455766;font-size:13px}
+.brief-facts {border-left-color:var(--paper-line);padding:0 21px;margin:23px 0;gap:16px}
