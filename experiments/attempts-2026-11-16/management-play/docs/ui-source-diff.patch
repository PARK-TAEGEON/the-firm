+}
+html {scrollbar-color:var(--line) var(--bg)}
+body {min-width:320px;background:var(--bg);color:var(--text);font-family:var(--sans);-webkit-font-smoothing:antialiased}
+button,input,select,textarea {font-family:inherit}
+button {line-height:1.5}
+button:focus-visible,input:focus-visible,select:focus-visible,summary:focus-visible {outline:2px solid var(--accent);outline-offset:3px}
+::selection {background:var(--accent);color:var(--accent-ink)}
+#app {min-width:0;min-height:100dvh}
+#app>*,.screen>*,.spread>*,.flex>*,.modal>*,.people-card>div,.case-context-main {min-width:0}
+.mono,.money,.sample-money,.top-date,.schedule-stat strong,.paper-fact strong,.paper-metric strong,.finance-number strong,.review-metrics strong {font-family:var(--numeric);font-variant-numeric:tabular-nums lining-nums}
+.eyebrow {font-size:12px;line-height:1.5;letter-spacing:.13em;color:var(--accent);font-weight:650}
