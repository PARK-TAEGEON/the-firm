+.goal-assumption {font-size:12px;line-height:1.7;color:var(--dim);margin-top:8px}
+.decision-focus {margin:0 0 22px}
+.decision-focus .section-top h2 {font-size:14px}
+.bottleneck-grid {gap:10px}
+.bottleneck-card {background:var(--warning-bg);border-color:color-mix(in srgb,var(--warning) 25%,var(--line));border-radius:4px;padding:14px 16px;gap:16px;align-items:center}
+.bottleneck-card:hover {background:color-mix(in srgb,var(--warning-bg) 92%,var(--warning));border-color:var(--warning)}
+.bottleneck-card strong {font-size:14px;line-height:1.6;font-weight:600}
+.bottleneck-card small {font-size:12px;line-height:1.7;color:var(--muted);margin-top:4px}
+.bottleneck-cta {font-size:12px;color:var(--warning)}
+.brief-grid,.bottom-grid {grid-template-columns:minmax(0,1fr) 272px;gap:24px}
+.brief-paper {border-radius:4px;background:var(--paper);color:var(--ink);grid-template-columns:minmax(0,1fr) 212px;min-height:255px;box-shadow:none;border:1px solid var(--paper-line)}
+.brief-body {padding:23px 26px}
