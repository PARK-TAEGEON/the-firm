+.play-mode-line .link-btn {font-size:12px}
+.play-goals {gap:0;border:1px solid var(--line);border-radius:4px;background:var(--surface);overflow:hidden}
+.play-goal {border:0;border-top:2px solid var(--line);border-right:1px solid var(--line-soft);background:transparent;padding:13px 17px;border-radius:0}
+.play-goal:last-child {border-right:0}
+.play-goal .goal-title {font-size:12px;color:var(--muted)}
+.play-goal strong {font-size:16px;line-height:1.6;margin:4px 0;font-weight:600;letter-spacing:-.02em}
