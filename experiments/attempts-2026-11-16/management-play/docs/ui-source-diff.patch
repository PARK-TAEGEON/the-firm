+.team-mini .workload {font-size:14px;line-height:1.5;font-family:var(--numeric);color:var(--text)}
+.team-mini .workload small {font-size:12px;color:var(--dim);margin-top:4px}
+.recent-report p {font-size:13px;line-height:1.8}
