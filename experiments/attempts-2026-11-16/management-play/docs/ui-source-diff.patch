+.empty p {font-size:13px;color:var(--muted)}
+
+/* The workday: risk -> choice -> current plan -> deliberate advance. */
+.office-command {background:var(--surface);border:1px solid var(--line);border-radius:5px;margin-bottom:20px;overflow:hidden;box-shadow:0 6px 24px #0001}
