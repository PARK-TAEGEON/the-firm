+.top-date {font-size:15px;padding-left:24px;line-height:1.4}
+.top-date small {font-size:12px;margin-top:6px;letter-spacing:0}
+.advance {min-height:48px;min-width:166px;font-size:16px;padding:10px 18px;box-shadow:0 3px 16px #0002}
+.advance svg {margin-left:10px}
